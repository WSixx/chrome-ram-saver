{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "RAM Saver",
  "description": "__MSG_appDesc__",
  "version": "1.5.0",
  "default_locale": "en",
  "permissions": ["tabs", "storage", "alarms", "windows", "scripting", "tabGroups"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_appName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
